{
  "name": "atlas-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "test:health": "tsx scripts/health-metrics.test.ts",
    "test:atlas-ai": "tsx scripts/atlas-ai-runtime.test.ts && tsx scripts/mobile-deep-link.test.ts",
    "test:front": "npm run test:health && npm run test:atlas-ai && npm run test:memory && npm run test:engineering",
    "test:memory": "tsx scripts/memory-review-filters.test.ts && tsx scripts/memory-review-navigation.test.ts && tsx scripts/memory-review-shortcuts.test.ts && tsx scripts/memory-review-batch.test.ts && tsx scripts/memory-review-safety.test.ts && tsx scripts/memory-home-summary.test.ts && tsx scripts/memory-provider-projection.test.ts",
    "test:engineering": "tsx scripts/engineering-knowledge.test.ts && tsx scripts/engineering-tool-runtime.test.ts",
    "dev:ios": "bash scripts/dev-ios.sh lan",
    "dev:ios:clear": "CLEAR=1 bash scripts/dev-ios.sh lan",
    "dev:ios:tunnel": "bash scripts/dev-ios.sh tunnel",
    "dev:ios:restart": "ATLAS_KILL_METRO=1 bash scripts/dev-ios.sh lan",
    "build:ios:dev": "bash scripts/eas-build-ios.sh development",
    "build:ios:preview": "bash scripts/eas-build-ios.sh preview",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@hookform/resolvers": "^5.2.2",
    "@kingstinct/react-native-healthkit": "^14.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tamagui/config": "^2.0.0-rc.41",
    "@tanstack/react-query": "^5.100.5",
    "expo": "~54.0.33",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-background-task": "~1.0.10",
    "expo-calendar": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.74.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-mmkv": "^4.3.1",
    "react-native-nitro-modules": "^0.35.6",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1",
    "tamagui": "^2.0.0-rc.41",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tamagui/babel-plugin": "^2.0.0-rc.41",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
